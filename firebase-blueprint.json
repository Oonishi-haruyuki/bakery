{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "GameState": {
      "title": "GameState",
      "description": "The current state of the bakery game",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "money": { "type": "number" },
        "day": { "type": "number" },
        "dailyEarnings": { "type": "number" },
        "reputation": { "type": "number" },
        "shopLevel": { "type": "number" },
        "levelProgressSales": { "type": "number" },
        "ingredients": { "type": "object" },
        "ingredientLimits": { "type": "object" },
        "inventory": { "type": "object" },
        "isShopOpen": { "type": "boolean" },
        "bakingStatus": { "type": "object" },
        "upgrades": { "type": "object" },
        "currentMissions": { "type": "array" },
        "allMissionsBonusClaimed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "money", "day", "shopLevel", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/gameStates/{userId}": {
      "schema": "GameState",
      "description": "User's current game state"
    }
  }
}
